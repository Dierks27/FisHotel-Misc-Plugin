{
	"_about": "Invented lines, shares and numbers. The PHP (Costing, Admin_Workbook, Box_Shares) and the order page's JS (clean-room-admin.js) are both run against this file, so the two sides of the percent-of-a-box maths cannot drift apart.",
	"pct": [
		["25", 25],
		["12.5", 12.5],
		[" 33.333 ", 33.33],
		["50%", 50],
		[".5", 0.5],
		["1e2", 100],
		["400", 400],
		["400.01", null],
		["0", null],
		["0.004", null],
		["", null],
		["-5", null],
		["abc", null],
		["12,5", null],
		[null, null],
		[7.25, 7.25]
	],
	"box_no": [
		["1", 1],
		[" 7 ", 7],
		["999", 999],
		[12, 12],
		["0", null],
		["1000", null],
		["2.5", null],
		["-1", null],
		["x", null],
		["", null],
		[null, null]
	],
	"state": [
		[0, "under"],
		[89.99, "under"],
		[90, "full"],
		[100, "full"],
		[110, "full"],
		[110.01, "over"],
		[250, "over"]
	],
	"summary": [
		{
			"name": "two boxes, a loose line, lines without a percent left out",
			"lines": [
				{ "box_no": "1", "box_pct": "25" },
				{ "box_no": "1", "box_pct": "40.5" },
				{ "box_no": "1", "box_pct": "30" },
				{ "box_no": "2", "box_pct": "60" },
				{ "box_no": "", "box_pct": "35" },
				{ "box_no": "3", "box_pct": "" },
				{ "box_no": "2", "box_pct": "0" }
			],
			"boxes": "2",
			"expect": {
				"boxes": [
					{ "box_no": 1, "pct": 95.5, "lines": 3, "state": "full" },
					{ "box_no": 2, "pct": 60, "lines": 1, "state": "under" }
				],
				"unboxed": { "pct": 35, "lines": 1 },
				"lines": 5,
				"pct_total": 190.5,
				"boxes_total": 1.905,
				"order_boxes": 2
			},
			"rows": [
				{ "state": "full", "text": "Box 1 · 95.5% · about full" },
				{ "state": "under", "text": "Box 2 · 60% · under" },
				{ "state": "unboxed", "text": "no box number · 35% · lines: 1" }
			],
			"total": "Boxes by the percents: 1.91 · Boxes field: 2"
		},
		{
			"name": "thirds add up to exactly 100; the edges of about full; a line that spans boxes; no Boxes field",
			"lines": [
				{ "box_no": "1", "box_pct": "33.33" },
				{ "box_no": "4", "box_pct": "110.01" },
				{ "box_no": "1", "box_pct": "33.33" },
				{ "box_no": "2", "box_pct": "90" },
				{ "box_no": "3", "box_pct": "89.99" },
				{ "box_no": "1", "box_pct": "33.34" },
				{ "box_pct": "250" }
			],
			"boxes": "",
			"expect": {
				"boxes": [
					{ "box_no": 1, "pct": 100, "lines": 3, "state": "full" },
					{ "box_no": 2, "pct": 90, "lines": 1, "state": "full" },
					{ "box_no": 3, "pct": 89.99, "lines": 1, "state": "under" },
					{ "box_no": 4, "pct": 110.01, "lines": 1, "state": "over" }
				],
				"unboxed": { "pct": 250, "lines": 1 },
				"lines": 7,
				"pct_total": 640,
				"boxes_total": 6.4,
				"order_boxes": null
			},
			"rows": [
				{ "state": "full", "text": "Box 1 · 100% · about full" },
				{ "state": "full", "text": "Box 2 · 90% · about full" },
				{ "state": "under", "text": "Box 3 · 89.99% · under" },
				{ "state": "over", "text": "Box 4 · 110.01% · over" },
				{ "state": "unboxed", "text": "no box number · 250% · lines: 1" }
			],
			"total": "Boxes by the percents: 6.4 · Boxes field: not set"
		},
		{
			"name": "no line has a percent",
			"lines": [
				{ "box_no": "1" },
				{}
			],
			"boxes": 3,
			"expect": {
				"boxes": [],
				"unboxed": { "pct": 0, "lines": 0 },
				"lines": 0,
				"pct_total": 0,
				"boxes_total": 0,
				"order_boxes": 3
			},
			"rows": [],
			"total": "No line has a percent yet: every line uses its per-box count."
		}
	],
	"shares": [
		{ "fish_key": "s:7", "size_slug": "2-3", "pct_per_fish": 12.5, "order_count": 3 },
		{ "fish_key": "s:7", "size_slug": "", "pct_per_fish": 10, "order_count": 1 },
		{ "fish_key": "n:green test blenny", "size_slug": "1-2", "pct_per_fish": 8.3333, "order_count": 2 },
		{ "fish_key": "n:blue test wrasse", "size_slug": "2-3", "pct_per_fish": 99, "order_count": 9 }
	],
	"suggest": [
		{
			"name": "by species id (not the share kept under the name), x the received count",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": 2, "qty_ordered": 4, "box_pct": "" },
			"expect": { "pct": 25, "orders": 3, "count": 2 },
			"text": "suggested 25% (from 3 orders)"
		},
		{
			"name": "nothing received yet: x the ordered count",
			"line": { "species_id": "7", "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": "", "qty_ordered": "4" },
			"expect": { "pct": 50, "orders": 3, "count": 4 },
			"text": "suggested 50% (from 3 orders)"
		},
		{
			"name": "a line without a size reads the share without a size",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "", "qty_received": 1 },
			"expect": { "pct": 10, "orders": 1, "count": 1 },
			"text": "suggested 10% (from 1 order)"
		},
		{
			"name": "by name, whatever the case and the spacing; 8.3333 x 3 is 25",
			"line": { "species": "  GREEN  test Blenny ", "size_slug": "1-2", "qty_received": 3 },
			"expect": { "pct": 25, "orders": 2, "count": 3 },
			"text": "suggested 25% (from 2 orders)"
		},
		{
			"name": "an id with no share falls back to the name",
			"line": { "species_id": 99, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": 1 },
			"expect": { "pct": 99, "orders": 9, "count": 1 },
			"text": "suggested 99% (from 9 orders)"
		},
		{
			"name": "another size: nothing",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "3-4", "qty_received": 2 },
			"expect": null
		},
		{
			"name": "a line that has a percent gets no suggestion",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": 2, "box_pct": "30" },
			"expect": null
		},
		{
			"name": "no count: nothing",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": 0, "qty_ordered": 0 },
			"expect": null
		},
		{
			"name": "never more than a line may take",
			"line": { "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_received": 40 },
			"expect": { "pct": 400, "orders": 3, "count": 40 },
			"text": "suggested 400% (from 3 orders)"
		}
	],
	"how_full": [
		{
			"name": "remembered shares x the ordered counts, a typed percent as typed, a line with nothing remembered, a line with nothing ordered left out",
			"lines": [
				{ "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_ordered": 4 },
				{ "species": "Green Test Blenny", "size_slug": "1-2", "qty_ordered": 6 },
				{ "species": "Red Test Goby", "size_slug": "1-2", "qty_ordered": 10 },
				{ "species_id": 7, "species": "Blue Test Wrasse", "size_slug": "2-3", "qty_ordered": 2, "box_pct": "30" },
				{ "species": "Yellow Test Goby", "qty_ordered": 0 }
			],
			"expect": { "pct": 130, "boxes": 1.3, "known": 2, "typed": 1, "unknown": 1, "lines": 4 },
			"text": "How full: boxes for the ordered counts: about 1.3 · lines with a remembered share or a typed %: 3 · lines with no remembered share yet: 1"
		},
		{
			"name": "nothing remembered for these fish",
			"lines": [
				{ "species": "Red Test Goby", "qty_ordered": 5 },
				{ "species": "Yellow Test Goby", "qty_ordered": 2 }
			],
			"expect": { "pct": 0, "boxes": 0, "known": 0, "typed": 0, "unknown": 2, "lines": 2 },
			"text": "How full: nothing is remembered for this supplier and origin yet · lines with no remembered share yet: 2"
		},
		{
			"name": "no lines",
			"lines": [],
			"expect": { "pct": 0, "boxes": 0, "known": 0, "typed": 0, "unknown": 0, "lines": 0 },
			"text": "How full: nothing to add up yet — no line has an ordered count."
		}
	]
}
